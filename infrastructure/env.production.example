# Non-secret runtime values for both Cloud Run services.
APP_NAME=jobpilot-api
ENVIRONMENT=production
GOOGLE_CLOUD_PROJECT=REPLACE_WITH_PROJECT_ID
FIRESTORE_PROJECT_ID=REPLACE_WITH_PROJECT_ID
WORKFLOW_REPOSITORY_MODE=firestore
WORKFLOW_COLLECTION=jobpilot-workflows
PUBSUB_MODE=google
PUBSUB_PROJECT_ID=REPLACE_WITH_PROJECT_ID
PUBSUB_TOPIC=jobpilot-workflows
GEMINI_MODEL=gemini-3.5-flash

# Supply GEMINI_API_KEY through Secret Manager or an approved runtime secret store.
# Never put the value in this file or in a committed service-account JSON file.